{
  "name": "@myst-theme/book",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "compile": "bun run build:bootstrap && tsc --noEmit --skipLibCheck",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:copy": "cp vite.config.dev.ts vite.config.ts && cp react-router.dynamic.config.ts react-router.config.ts",
    "prod:copy": "cp vite.config.prod.ts vite.config.ts && cp react-router.dynamic.config.ts react-router.config.ts",
    "render:copy": "cp vite.config.prod.ts vite.config.ts && cp react-router.static.config.ts react-router.config.ts",
    "clean": "rm -rf public/build build api",
    "build:thebe": "copy-thebe-assets ./public",
    "build:bootstrap": "node scripts/boostrap.mjs",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "dev": "bun run dev:copy && bun run build:bootstrap && bun run build:thebe && concurrently \"bun run dev:css\" \"bun run react-router dev\"",
    "build": "bun run prod:copy && bun run build:bootstrap && bun run build:thebe && bun run build:css && bun run react-router build",
    "prod:build": "bun run build",
    "render:fixup": "bun run scripts/fixup.mjs",
    "render": "bun run build:css && bun run build:thebe && bun run render:copy && bun run react-router build && bun run render:fixup",
    "start": "react-router-serve build/server/index.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@myst-theme/anywidget": "^1.3.1",
    "@myst-theme/common": "^1.3.1",
    "@myst-theme/frontmatter": "^1.3.1",
    "@myst-theme/icons": "^1.3.1",
    "@myst-theme/jupyter": "^1.3.1",
    "@myst-theme/landing-pages": "^1.3.1",
    "@myst-theme/providers": "^1.3.1",
    "@myst-theme/search": "^1.3.1",
    "@myst-theme/search-minisearch": "^1.3.1",
    "@myst-theme/site": "^1.3.1",
    "@myst-theme/styles": "^1.3.1",
    "classnames": "^2.3.2",
    "myst-common": "^1.8.1",
    "myst-config": "^1.8.1",
    "myst-migrate": "^1.7.1",
    "myst-spec-ext": "^1.8.1",
    "myst-to-react": "^1.3.1",
    "node-fetch": "^2.6.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.0.0",
    "@react-router/node": "^8.0.0",
    "thebe-core": "^0.5.0",
    "@module-federation/runtime-tools": "^2.6.0",
    "@module-federation/runtime": "^2.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.0.0",
    "@react-router/fs-routes": "^8.0.0",
    "@react-router/serve": "^8.0.0",
    "@remix-run/eslint-config": "~2.17.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node-fetch": "^2.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.0.0",
    "vite-env-only": "^3.0.3"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "bun@1.3.10"
}
