{
  "name": "@myst-theme/book",
  "version": "1.3.1",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "compile": "tsc --noEmit --skipLibCheck",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "dev:copy": "cp remix.config.dev.js remix.config.cjs",
    "prod:copy": "cp remix.config.prod.js remix.config.cjs",
    "clean": "rm -rf public/build build api",
    "build:thebe": "copy-thebe-assets ./public",
    "prod:build": "bun run prod:copy && bun run build:thebe && bun run build:css && bun run remix build",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "dev": "bun run dev:copy && bun run build:thebe && concurrently \"bun run dev:css\" \"bun run remix dev\"",
    "start": "bun run build:css && bun run remix dev"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@myst-theme/anywidget": "^1.3.1",
    "@myst-theme/common": "^1.3.1",
    "@myst-theme/frontmatter": "^1.3.1",
    "@myst-theme/icons": "^1.3.1",
    "@myst-theme/jupyter": "^1.3.1",
    "@myst-theme/landing-pages": "^1.3.1",
    "@myst-theme/providers": "^1.3.1",
    "@myst-theme/search": "^1.3.1",
    "@myst-theme/search-minisearch": "^1.3.1",
    "@myst-theme/site": "^1.3.1",
    "@myst-theme/styles": "^1.3.1",
    "@remix-run/node": "~2.17.5",
    "@remix-run/react": "~2.17.5",
    "classnames": "^2.3.2",
    "myst-spec-ext": "^1.8.1",
    "myst-to-react": "^1.3.1",
    "myst-common": "^1.8.1",
    "myst-config": "^1.8.1",
    "myst-migrate": "^1.7.1",
    "node-fetch": "^2.6.11",
    "thebe-core": "^0.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@remix-run/dev": "~2.17.0",
    "@remix-run/eslint-config": "~2.17.0",
    "@remix-run/serve": "~2.17.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node-fetch": "^2.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "bun@1.3.10"
}
