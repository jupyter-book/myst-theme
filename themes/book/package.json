{
  "name": "@myst-theme/book",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "compile": "react-router typegen && tsc --noEmit --skipLibCheck",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "copy:thebe": "copy-thebe-assets ./public",
    "build:pre": "bun run build:css && bun run copy:thebe",
    "clean": "rm -rf public/build build api",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "dev": "concurrently \"bun run copy:thebe\" \"bun run dev:css\" \"cross-env NODE_ENV=development tsx server.ts\"",
    "build": "bun run build:pre && react-router build",
    "build:renderer": "bun run build:pre && cross-env VITE_BUILD_HTML=1 react-router build",
    "render": "cross-env NODE_ENV=production node ./build/server/index.js",
    "start": "cross-env NODE_ENV=production node build/server/index.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@myst-theme/anywidget": "^1.4.1",
    "@myst-theme/common": "^1.4.1",
    "@myst-theme/frontmatter": "^1.4.1",
    "@myst-theme/icons": "^1.4.1",
    "@myst-theme/jupyter": "^1.4.1",
    "@myst-theme/landing-pages": "^1.4.1",
    "@myst-theme/prerender": "^0.0.1",
    "@myst-theme/providers": "^1.4.1",
    "@myst-theme/search": "^1.4.1",
    "@myst-theme/search-minisearch": "^1.4.1",
    "@myst-theme/site": "^1.4.1",
    "@myst-theme/styles": "^1.4.1",
    "@react-router/express": "^8.0.0",
    "@react-router/node": "^8.0.0",
    "classnames": "^2.3.2",
    "compression": "^1.7.4",
    "cross-env": "^10.1.0",
    "express": "^4.18.2",
    "get-port": "^5.1.1",
    "isbot": "^5",
    "morgan": "^1.10.0",
    "myst-common": "^1.8.1",
    "myst-config": "^1.8.1",
    "myst-migrate": "^1.7.1",
    "myst-spec-ext": "^1.8.1",
    "myst-to-react": "^1.4.1",
    "node-fetch": "^2.6.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.0.0",
    "thebe-core": "^0.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.0.0",
    "@react-router/fs-routes": "^8.0.0",
    "@remix-run/eslint-config": "~2.17.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/node-fetch": "^2.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.22.3",
    "vite": "^8.0.0",
    "vite-env-only": "^3.0.3"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "bun@1.3.10"
}
